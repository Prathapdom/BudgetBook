<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BudgetBook.Pages.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:BudgetBook.Data"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}"
          Padding="{ThemeResource AppPagePadding}"
          RowSpacing="{ThemeResource AppSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppControlSpacing}" VerticalAlignment="Center">
                <Button Command="{x:Bind Vm.PreviousMonthCommand}" Content="&#xE76B;"
                        FontFamily="{StaticResource SymbolThemeFontFamily}" />
                <TextBlock Text="{x:Bind Vm.MonthLabel, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" MinWidth="180" TextAlignment="Center" />
                <Button Command="{x:Bind Vm.NextMonthCommand}" Content="&#xE76C;"
                        FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppControlSpacing}" HorizontalAlignment="Right">
                <Button Click="Add_Click" Style="{StaticResource AppAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button>
                <Button Click="Edit_Click" Content="Edit" />
                <Button Command="{x:Bind Vm.DeleteSelectedCommand}" Content="Delete" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind Vm.Items, Mode=OneWay}"
                  SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
                  DoubleTapped="List_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:TransactionRecord">
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DateLabel}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind CategoryName}" />
                            <TextBlock Text="{x:Bind Note}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind AccountName}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" HorizontalAlignment="Right"
                                   Text="{x:Bind SignedAmountLabel}"
                                   Foreground="{ThemeResource AppNeutralAmountBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

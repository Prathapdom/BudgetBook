<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BudgetBook.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BudgetBook.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,16" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <StackPanel Spacing="4">
                <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="ThemeBox" Header="Theme" SelectionChanged="ThemeBox_SelectionChanged">
                    <ComboBoxItem Content="Use system setting" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Data" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind DbPath}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Click="Export_Click" Content="Export transactions to CSV" />
                    <Button Click="OpenFolder_Click" Content="Open data folder" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="BudgetBook — a simple local budget tracker. Version 1.0.0." TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

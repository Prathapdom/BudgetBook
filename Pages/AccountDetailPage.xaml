<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="BudgetBook.Pages.AccountDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cards="using:BudgetBook.Controls.Cards" xmlns:charts="using:BudgetBook.Controls.Charts" xmlns:common="using:BudgetBook.Controls.Common"
    xmlns:data="using:BudgetBook.Data" mc:Ignorable="d">
    <ScrollViewer Background="{ThemeResource AppPageBackgroundBrush}">
        <StackPanel Padding="{ThemeResource AppPagePadding}" Spacing="{ThemeResource AppSectionSpacing}">
            <Grid><StackPanel><TextBlock Text="{x:Bind Vm.Account.Account.Name, Mode=OneWay}" Style="{StaticResource AppPageTitleTextStyle}" /><TextBlock Text="Account details" Style="{StaticResource AppSecondaryTextStyle}" /></StackPanel><Button HorizontalAlignment="Right" Content="View filtered transactions" Click="ViewTransactions_Click" /></Grid>
            <cards:MetricCard Title="Current balance" Value="{x:Bind Vm.BalanceLabel, Mode=OneWay}" Glyph="&#xE850;" Tone="Accent" Subtitle="Opening balance plus all activity" />
            <cards:AppCard><StackPanel Spacing="12"><TextBlock Text="Six-month balance movement" Style="{StaticResource AppSectionTitleTextStyle}" /><charts:CashFlowChart ItemsSource="{x:Bind Vm.Trend}" /></StackPanel></cards:AppCard>
            <TextBlock Text="Transactions" Style="{StaticResource AppSectionTitleTextStyle}" />
            <ItemsControl ItemsSource="{x:Bind Vm.Transactions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="data:TransactionRecord"><common:TransactionListItem Transaction="{x:Bind}" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

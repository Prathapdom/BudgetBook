<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BudgetBook.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cards="using:BudgetBook.Controls.Cards"
    xmlns:vm="using:BudgetBook.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}"
          Padding="{ThemeResource AppPagePadding}"
          RowSpacing="{ThemeResource AppSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Accounts" Style="{StaticResource AppPageTitleTextStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppControlSpacing}" HorizontalAlignment="Right">
                <Button Click="Add_Click" Style="{StaticResource AppAccentButtonStyle}" Content="Add" />
                <Button Click="Edit_Click" Content="Edit" />
                <Button Command="{x:Bind Vm.DeleteSelectedCommand}" Content="Delete" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind Vm.Items, Mode=OneWay}"
                  SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
                  HorizontalContentAlignment="Stretch"
                  DoubleTapped="List_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow">
                    <cards:AccountCard AccountName="{x:Bind Account.Name}"
                                       BalanceLabel="{x:Bind BalanceLabel}"
                                       CurrencyCode="{x:Bind Account.Currency}"
                                       Subtitle="Current balance"
                                       Margin="0,3" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

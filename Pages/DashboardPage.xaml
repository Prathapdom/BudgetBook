<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BudgetBook.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BudgetBook.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Month selector -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Command="{x:Bind Vm.PreviousMonthCommand}" Content="&#xE76B;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}" />
            <TextBlock Text="{x:Bind Vm.MonthLabel, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" MinWidth="180" TextAlignment="Center" />
            <Button Command="{x:Bind Vm.NextMonthCommand}" Content="&#xE76C;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}" />
        </StackPanel>

        <!-- Summary tiles -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Income" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.Income, Mode=OneWay, Converter={StaticResource Currency}}"
                               Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Expense" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.Expense, Mode=OneWay, Converter={StaticResource Currency}}"
                               Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Net" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.Net, Mode=OneWay, Converter={StaticResource Currency}}"
                               Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="Spending by category"
                   Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="10">
                <ItemsControl ItemsSource="{x:Bind Vm.Spend, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryBarVm">
                            <Grid ColumnSpacing="12" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" HorizontalAlignment="Left" Height="20" CornerRadius="4"
                                        Background="{x:Bind ColorHex, Converter={StaticResource HexToBrush}}"
                                        Width="{x:Bind Fraction, Converter={StaticResource FractionToWidth}}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind AmountLabel}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No expenses recorded this month."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind Vm.HasSpend, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

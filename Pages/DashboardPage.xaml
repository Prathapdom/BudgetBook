<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BudgetBook.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cards="using:BudgetBook.Controls.Cards"
    xmlns:common="using:BudgetBook.Controls.Common"
    xmlns:vm="using:BudgetBook.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}"
          Padding="{ThemeResource AppPagePadding}"
          RowSpacing="{ThemeResource AppSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Month selector -->
        <StackPanel Orientation="Horizontal" Spacing="{ThemeResource AppControlSpacing}" VerticalAlignment="Center">
            <Button Command="{x:Bind Vm.PreviousMonthCommand}" Content="&#xE76B;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}" />
            <TextBlock Text="{x:Bind Vm.MonthLabel, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" MinWidth="180" TextAlignment="Center" />
            <Button Command="{x:Bind Vm.NextMonthCommand}" Content="&#xE76C;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}" />
        </StackPanel>

        <!-- Summary tiles -->
        <Grid Grid.Row="1" ColumnSpacing="{ThemeResource AppCardSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <cards:MetricCard Grid.Column="0" Title="Income" Glyph="&#xE8C7;" Tone="Positive"
                              Value="{x:Bind Vm.Income, Mode=OneWay, Converter={StaticResource Currency}}" />
            <cards:MetricCard Grid.Column="1" Title="Expense" Glyph="&#xE9D2;" Tone="Negative"
                              Value="{x:Bind Vm.Expense, Mode=OneWay, Converter={StaticResource Currency}}" />
            <cards:MetricCard Grid.Column="2" Title="Net" Glyph="&#xE8EF;" Tone="Neutral"
                              Value="{x:Bind Vm.Net, Mode=OneWay, Converter={StaticResource Currency}}" />
        </Grid>

        <common:SectionHeader Grid.Row="2" Title="Spending by category"
                              Margin="{ThemeResource AppSectionHeaderMargin}" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="{ThemeResource AppControlSpacing}">
                <ItemsControl ItemsSource="{x:Bind Vm.Spend, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryBarVm">
                            <Grid ColumnSpacing="12" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" HorizontalAlignment="Left" Height="20" CornerRadius="4"
                                        Background="{x:Bind ColorHex, Converter={StaticResource HexToBrush}}"
                                        Width="{x:Bind Fraction, Converter={StaticResource FractionToWidth}}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind AmountLabel}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <common:EmptyState Title="No expenses this month"
                                   Message="Add an expense to see the category breakdown here."
                                   Glyph="&#xE9D2;"
                                   Visibility="{x:Bind Vm.HasSpend, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

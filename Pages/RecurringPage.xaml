<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="BudgetBook.Pages.RecurringPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:data="using:BudgetBook.Data" xmlns:cards="using:BudgetBook.Controls.Cards" mc:Ignorable="d">
    <Grid Background="{ThemeResource AppPageBackgroundBrush}" Padding="{ThemeResource AppPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Recurring transactions" Style="{StaticResource AppPageTitleTextStyle}" /><TextBlock Text="Due entries are generated automatically when BudgetBook opens." Style="{StaticResource AppSecondaryTextStyle}" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="Add rule" Style="{StaticResource AppAccentButtonStyle}" Click="Add_Click" /><Button Content="Edit" Click="Edit_Click" /><Button Content="Delete" Click="Delete_Click" /></StackPanel></Grid>
        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Items}" SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}" HorizontalContentAlignment="Stretch" DoubleTapped="List_DoubleTapped" AutomationProperties.Name="Recurring transaction rules">
            <ListView.ItemTemplate><DataTemplate x:DataType="data:RecurringTransaction"><cards:AppCard Margin="0,3"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind Note}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind NextOccurrence}" Style="{StaticResource AppSecondaryTextStyle}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Amount, Converter={StaticResource Currency}}" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="{x:Bind Frequency}" Style="{StaticResource AppSecondaryTextStyle}" HorizontalAlignment="Right" /></StackPanel></Grid></cards:AppCard></DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

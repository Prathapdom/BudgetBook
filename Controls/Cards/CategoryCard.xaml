<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Cards.CategoryCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:BudgetBook.Controls.Cards">

    <cards:AppCard Command="{x:Bind Command, Mode=OneWay}"
                   CommandParameter="{x:Bind CommandParameter, Mode=OneWay}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{x:Bind CategoryBrush, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Foreground="White" FontSize="17" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind CategoryName, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                           Style="{StaticResource AppSecondaryTextStyle}" FontSize="12" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{x:Bind KindLabel, Mode=OneWay}"
                       Style="{StaticResource AppSecondaryTextStyle}"
                       VerticalAlignment="Center" />
        </Grid>
    </cards:AppCard>
</UserControl>

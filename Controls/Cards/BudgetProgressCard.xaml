<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Cards.BudgetProgressCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:BudgetBook.Controls.Cards">

    <cards:AppCard Command="{x:Bind Command, Mode=OneWay}"
                   CommandParameter="{x:Bind CommandParameter, Mode=OneWay}">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind CategoryName, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind SpentLabel, Mode=OneWay}"
                               Style="{StaticResource AppSecondaryTextStyle}" FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind RemainingLabel, Mode=OneWay}"
                           x:Name="RemainingText" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar x:Name="BudgetProgress" Minimum="0" Maximum="1"
                         Value="{x:Bind Progress, Mode=OneWay}" Height="6" />
            <Grid>
                <TextBlock Text="Spent" Style="{StaticResource AppSecondaryTextStyle}" FontSize="11" />
                <TextBlock Text="{x:Bind LimitLabel, Mode=OneWay}"
                           Style="{StaticResource AppSecondaryTextStyle}" FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </cards:AppCard>
</UserControl>

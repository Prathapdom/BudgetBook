<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Cards.MetricCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:BudgetBook.Controls.Cards">

    <cards:AppCard Command="{x:Bind Command, Mode=OneWay}"
                   CommandParameter="{x:Bind CommandParameter, Mode=OneWay}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ValueText"
                           Text="{x:Bind Value, Mode=OneWay}"
                           Style="{StaticResource AppMetricValueTextStyle}" />
                <TextBlock x:Name="SupportingText"
                           Text="{x:Bind Subtitle, Mode=OneWay}"
                           Style="{StaticResource AppSecondaryTextStyle}"
                           FontSize="12" />
            </StackPanel>
            <Border x:Name="IconContainer" Grid.Column="1"
                    Width="36" Height="36" CornerRadius="18"
                    Background="{ThemeResource AppAccentSubtleBrush}">
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                          Foreground="{ThemeResource AppAccentBrush}"
                          FontSize="16" />
            </Border>
        </Grid>
    </cards:AppCard>
</UserControl>

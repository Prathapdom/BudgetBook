<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Charts.AccountDistributionChart"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">
    <Grid>
        <Grid x:Name="ContentRoot" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <lvc:PieChart x:Name="Chart" LegendPosition="Hidden" TooltipPosition="Auto"
                          Background="{ThemeResource AppChartBackgroundBrush}"
                          AutomationProperties.Name="Account balance distribution donut chart" />
            <ItemsControl Grid.Row="1" x:Name="SummaryList"
                          AutomationProperties.Name="Account balance distribution table">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="12" Height="12" CornerRadius="2"
                                    Background="{Binding Brush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}"
                                       Style="{StaticResource AppSecondaryTextStyle}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <StackPanel x:Name="EmptyRoot" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="6">
            <FontIcon Glyph="&#xE8C7;" FontSize="26" HorizontalAlignment="Center" />
            <TextBlock Text="No positive account balances" Style="{StaticResource AppSectionTitleTextStyle}" />
            <TextBlock Text="Account allocation will appear here." Style="{StaticResource AppSecondaryTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>

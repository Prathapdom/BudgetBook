<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Charts.CategoryDonutChart"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">
    <Grid>
        <Grid x:Name="ContentRoot" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <lvc:PieChart x:Name="Chart" LegendPosition="Hidden" TooltipPosition="Auto"
                          Background="{ThemeResource AppChartBackgroundBrush}"
                          AutomationProperties.Name="Expense distribution donut chart" />
            <ItemsControl Grid.Row="1" x:Name="SummaryList"
                          AutomationProperties.Name="Expense distribution table">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalContentAlignment="Stretch" Padding="6,4"
                                Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="{Binding Label}"
                                Click="LegendItem_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="12" Height="12" CornerRadius="6"
                                        Background="{Binding Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Value}"
                                           Style="{StaticResource AppSecondaryTextStyle}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <StackPanel x:Name="EmptyRoot" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="6">
            <FontIcon Glyph="&#xE9D2;" FontSize="26" HorizontalAlignment="Center" />
            <TextBlock Text="No expenses in this period" Style="{StaticResource AppSectionTitleTextStyle}" />
            <TextBlock Text="Expense categories will appear here." Style="{StaticResource AppSecondaryTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Charts.IncomeExpenseChart"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">
    <Grid>
        <StackPanel x:Name="ContentRoot" Spacing="8">
            <lvc:CartesianChart x:Name="Chart" Height="260" LegendPosition="Top"
                                Background="{ThemeResource AppChartBackgroundBrush}"
                                TooltipPosition="Top" AutomationProperties.Name="Income versus expenses column chart" />
            <Expander Header="View income and expense data" HorizontalAlignment="Stretch">
                <ItemsControl x:Name="SummaryList" AutomationProperties.Name="Income and expense data table">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding PrimaryValue}" />
                                <TextBlock Grid.Column="2" Text="{Binding SecondaryValue}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
        <StackPanel x:Name="EmptyRoot" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="6">
            <FontIcon Glyph="&#xE9D2;" FontSize="26" HorizontalAlignment="Center" />
            <TextBlock Text="Nothing to compare" Style="{StaticResource AppSectionTitleTextStyle}" />
            <TextBlock Text="Add income or expenses to compare them." Style="{StaticResource AppSecondaryTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>

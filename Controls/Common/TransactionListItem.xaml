<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Common.TransactionListItem"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:BudgetBook.Controls.Cards"
    xmlns:common="using:BudgetBook.Controls.Common">
    <cards:AppCard Padding="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DateText" Style="{StaticResource AppSecondaryTextStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="CategoryText" FontWeight="SemiBold" />
                <TextBlock x:Name="NoteText" FontSize="12" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource AppSecondaryTextStyle}" />
            </StackPanel>
            <TextBlock x:Name="AccountText" Grid.Column="2" VerticalAlignment="Center"
                       Style="{StaticResource AppSecondaryTextStyle}" />
            <common:AmountText x:Name="TransactionAmount" Grid.Column="3"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               ShowSign="True" FontWeight="SemiBold" />
        </Grid>
    </cards:AppCard>
</UserControl>

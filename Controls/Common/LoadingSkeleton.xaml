<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Common.LoadingSkeleton"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="SkeletonFill" MinHeight="16"
            Background="{ThemeResource AppSubtleFillBrush}"
            CornerRadius="{ThemeResource AppControlCornerRadius}">
        <Border.Resources>
            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="SkeletonFill"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.42" To="0.86" Duration="0:0:0.8" />
            </Storyboard>
        </Border.Resources>
    </Border>
</UserControl>

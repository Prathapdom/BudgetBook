<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BudgetBook.Controls.Common.EmptyState"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="8" Padding="24" MaxWidth="420">
        <Border Width="48" Height="48" CornerRadius="24"
                Background="{ThemeResource AppAccentSubtleBrush}"
                HorizontalAlignment="Center">
            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                      Foreground="{ThemeResource AppAccentBrush}" FontSize="20" />
        </Border>
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                   TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Text="{x:Bind Message, Mode=OneWay}"
                   Style="{StaticResource AppSecondaryTextStyle}"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="ActionButton" Content="{x:Bind ActionText, Mode=OneWay}"
                Command="{x:Bind ActionCommand, Mode=OneWay}"
                CommandParameter="{x:Bind ActionCommandParameter, Mode=OneWay}"
                Style="{StaticResource AppAccentButtonStyle}"
                HorizontalAlignment="Center" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>

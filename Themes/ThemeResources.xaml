    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="AppPagePadding">24,16,24,16</Thickness>
    <Thickness x:Key="AppCardPadding">16</Thickness>
    <Thickness x:Key="AppCompactCardPadding">12</Thickness>
    <Thickness x:Key="AppSectionHeaderMargin">0,8,0,0</Thickness>
    <CornerRadius x:Key="AppCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="AppControlCornerRadius">6</CornerRadius>

    <x:Double x:Key="AppSectionSpacing">16</x:Double>
    <x:Double x:Key="AppControlSpacing">8</x:Double>
    <x:Double x:Key="AppCardSpacing">12</x:Double>
    <x:Double x:Key="AppPageMaxWidth">1280</x:Double>

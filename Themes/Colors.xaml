<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="AppCardBackgroundHoverBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#18000000" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#14000000" />
            <SolidColorBrush x:Key="AppSubtleFillBrush" Color="#0A000000" />

            <SolidColorBrush x:Key="AppPositiveAmountBrush" Color="#087F5B" />
            <SolidColorBrush x:Key="AppNegativeAmountBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="AppNeutralAmountBrush" Color="#5D5D5D" />
            <SolidColorBrush x:Key="AppChartGridBrush" Color="#1F000000" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="{StaticResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="White" />

            <SolidColorBrush x:Key="AppChartPalette1" Color="#0067C0" />
            <SolidColorBrush x:Key="AppChartPalette2" Color="#0E7A5F" />
            <SolidColorBrush x:Key="AppChartPalette3" Color="#744DA9" />
            <SolidColorBrush x:Key="AppChartPalette4" Color="#C94F36" />
            <SolidColorBrush x:Key="AppChartPalette5" Color="#B26A00" />
            <SolidColorBrush x:Key="AppChartPalette6" Color="#007C91" />
            <SolidColorBrush x:Key="AppChartPalette7" Color="#A4262C" />
            <SolidColorBrush x:Key="AppChartPalette8" Color="#5C6BC0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="AppCardBackgroundHoverBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="AppSubtleFillBrush" Color="#0FFFFFFF" />

            <SolidColorBrush x:Key="AppPositiveAmountBrush" Color="#5CD6B3" />
            <SolidColorBrush x:Key="AppNegativeAmountBrush" Color="#FF8A7A" />
            <SolidColorBrush x:Key="AppNeutralAmountBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AppChartGridBrush" Color="#2EFFFFFF" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="{StaticResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="Black" />

            <SolidColorBrush x:Key="AppChartPalette1" Color="#4CA6EA" />
            <SolidColorBrush x:Key="AppChartPalette2" Color="#5CD6B3" />
            <SolidColorBrush x:Key="AppChartPalette3" Color="#B89BE3" />
            <SolidColorBrush x:Key="AppChartPalette4" Color="#FF8A7A" />
            <SolidColorBrush x:Key="AppChartPalette5" Color="#F5B95F" />
            <SolidColorBrush x:Key="AppChartPalette6" Color="#62C9D8" />
            <SolidColorBrush x:Key="AppChartPalette7" Color="#EE7A82" />
            <SolidColorBrush x:Key="AppChartPalette8" Color="#9FA8ED" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{StaticResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundHoverBrush" Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppSubtleFillBrush" Color="{StaticResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="AppPositiveAmountBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppNegativeAmountBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppNeutralAmountBrush" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppChartGridBrush" Color="{StaticResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="{StaticResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="AppChartPalette1" Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppChartPalette2" Color="{StaticResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="AppChartPalette3" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppChartPalette4" Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppChartPalette5" Color="{StaticResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="AppChartPalette6" Color="{StaticResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppChartPalette7" Color="{StaticResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppChartPalette8" Color="{StaticResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

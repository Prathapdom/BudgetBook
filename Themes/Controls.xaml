<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppCardCornerRadius}" />
        <Setter Property="Padding" Value="{ThemeResource AppCardPadding}" />
    </Style>

    <Style x:Key="AppSettingsGroupStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="MinWidth" Value="320" />
    </Style>

    <Style x:Key="AppAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppAccentForegroundBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}" />
    </Style>
</ResourceDictionary>
